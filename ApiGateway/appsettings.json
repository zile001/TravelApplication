{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Secret": "OvoJeMojSuperTajniKljucKojiMoraBitiDovoljnoDugacak123!"
  },
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },
      "travel-route": {
        "ClusterId": "travel-cluster",
        "AuthorizationPolicy": "AnyUser",
        "Match": {
          "Path": "/api/travel/{**catch-all}"
        }
      },
      "finance-route": {
        "ClusterId": "finance-cluster",
        "AuthorizationPolicy": "AnyUser",
        "Match": {
          "Path": "/api/finance/{**catch-all}"
        }
      },
      "checklist-route": {
        "ClusterId": "checklist-cluster",
        "AuthorizationPolicy": "AnyUser",
        "Match": {
          "Path": "/api/checklist/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:8694/"
          }
        }
      },
      "travel-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:8524/"
          }
        }
      },
      "finance-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:8346/"
          }
        }
      },
      "checklist-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:8266/"
          }
        }
      }
    }
  }
}